# PixelDebh's Retro Rescue — Variabili d'ambiente
# Copia questo file in `.env` e personalizza i valori.
# Solo variabili con prefisso VITE_ sono esposte al client (Vite).

# Titolo della pagina (mostrato in <title>)
VITE_APP_TITLE="PixelDebh's Retro Rescue"

# Path del logo/favicon servito da public/ (es. /favicon.png)
VITE_APP_LOGO="/favicon.png"
